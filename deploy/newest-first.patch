+    def _newest_uids(
+        self, folder: str, uids: List[int], criteria: List[bytes]
+    ) -> List[int]:
+        """Use server sorting or cached, read-only Date/INTERNALDATE metadata."""
+        conn = self.conn()
+        capabilities = {
+            (cap.decode("ascii", "replace") if isinstance(cap, bytes) else cap).upper()
+            for cap in (getattr(conn, "capabilities", ()) or ())
+        }
+        if any(cap == "SORT" or cap.startswith("SORT=") for cap in capabilities):
+            try:
+                status, data = conn.uid("SORT", "(DATE)", "UTF-8", *criteria)
+                if status == "OK":
+                    matched = set(uids)
+                    ordered = list(dict.fromkeys(
+                        int(uid) for uid in _first(data).split()
+                        if uid.isdigit() and int(uid) in matched
+                    ))
+                    if set(ordered) == matched:
+                        return list(reversed(ordered))
+            except imaplib.IMAP4.abort:
+                raise
+            except imaplib.IMAP4.error:
+                pass  # An advertised SORT implementation may reject this query.
+
+        # UIDVALIDITY invalidates cached UIDs after a mailbox is rebuilt. A
+        # reconnect also clears this cache in _reset(). Dates are immutable for
+        # a UID; flags and the matching UID set are still queried on every call.
+        responses = getattr(conn, "untagged_responses", {})
+        validity = (responses.get("UIDVALIDITY") or [id(conn)])[-1]
+        old_validity, dates = self._date_cache.get(folder, (None, {}))
+        if old_validity != validity:
+            dates = self._stored_dates(folder, validity)
+        self._date_cache[folder] = (validity, dates)
+        missing = [uid for uid in uids if uid not in dates]
+        for batch in _chunks(missing, 100):
+            status, data = conn.uid(
+                "FETCH", ",".join(str(uid) for uid in batch),
+                "(UID INTERNALDATE BODY.PEEK[HEADER.FIELDS (DATE)])",
+            )
+            if status != "OK":
+                raise ImapError(f"Date FETCH failed: {_first(data)}")
+            updated: Dict[int, float] = {}
+            for message in _parse_fetch_summaries(data, folder, self.account.name):
+                uid = int(message["id"].rsplit("|", 1)[1])
+                updated[uid] = date_sort_key(message.get("date"))
+            dates.update(updated)
+            self._stored_dates(folder, validity, updated)
+        return sorted(uids, key=lambda uid: (dates.get(uid, float("-inf")), uid), reverse=True)
+
+    def _stored_dates(
+        self, folder: str, validity: Any, updates: Optional[Dict[int, float]] = None
+    ) -> Dict[int, float]:
+        """Persist only UID/date metadata, scoped to mailbox identity and UIDVALIDITY."""
+        if not isinstance(validity, (bytes, str)):
+            return {}  # Without UIDVALIDITY, only the live connection is trustworthy.
+        identity = [self.account.imap_host, str(self.account.imap_port),
+                    self.account.imap_user, self.account.name, folder]
+        mailbox = hashlib.sha256("\0".join(identity).encode()).hexdigest()
+        version = validity.decode("ascii", "replace") if isinstance(validity, bytes) else validity
+        path = os.path.join(CONFIG_DIR, "date-index.sqlite3")
+        try:
+            fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
+            os.close(fd)
+            os.chmod(path, 0o600)
+            with sqlite3.connect(path, timeout=2) as store:
+                store.execute("CREATE TABLE IF NOT EXISTS dates (mailbox TEXT, validity TEXT, "
+                              "uid INTEGER, timestamp REAL, PRIMARY KEY (mailbox, uid))")
+                if updates is not None:
+                    store.execute("DELETE FROM dates WHERE mailbox = ? AND validity != ?", (mailbox, version))
+                    store.executemany("INSERT OR REPLACE INTO dates VALUES (?, ?, ?, ?)",
+                                      [(mailbox, version, uid, stamp) for uid, stamp in updates.items()])
+                    return {}
+                return dict(store.execute("SELECT uid, timestamp FROM dates "
+                                          "WHERE mailbox = ? AND validity = ?", (mailbox, version)))
+        except (OSError, sqlite3.Error):
+            return {}  # A read-only/unavailable cache must never change search correctness.
 
