+def date_sort_key(value: Optional[str]) -> float:
+    """Compare message dates by their actual instant, including timezone offsets."""
+    try:
+        dt = iso_to_datetime(value)
+        return dt.timestamp() if dt is not None else float("-inf")
+    except (ValueError, OverflowError, OSError):
+        return float("-inf")
 
 
